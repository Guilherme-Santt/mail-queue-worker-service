{
    "name": "queue-worker-service",
    "version": "1.0.0",
    "description": "Sistema de gerenciamento de filas e processamento assincrono em Node.js",
    "main": "src/server.js",
    "type": "module",
    "scripts": {
        "dev": "node --watch src/index.js",
        "start:api": "node src/server.js",
