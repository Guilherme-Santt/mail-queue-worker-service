        "dev:worker": "node --watch src/worker.js"
    },
    "dependencies": {
        "bullmq": "^5.0.0",
        "dotenv": "^16.4.5",
        "express": "^4.19.2",
        "ioredis": "^5.4.1",
        "sqlite": "^5.1.1",
        "sqlite3": "^5.1.7"
    }
}